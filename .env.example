# =============================================================================
# OneAndLab – Variables d'environnement (Backend + déploiement)
# =============================================================================
# Copier vers .env et remplir les valeurs (ne pas commiter .env).
# Sur le serveur ECS : placer ce fichier à /var/www/oneandlab/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données MySQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oneandlab
DB_USER=oneandlab
DB_PASS=

# --- Dev : BDD distante (EC2 / RDS) + Nuxt (optionnel) ---
#   ./rundev.sh --from-server-env
#   → tunnel SSH (même SSH_KEY / SSH_HOST que buildlocaloneandlab.sh) puis npm run dev dans frontend/
#   Tunnel seul : ./rundev.sh --tunnel-only --from-server-env
# Ou : ./rundev.sh <host MySQL vu depuis l’EC2, ex. endpoint RDS>
# Puis dans ton .env local (non versionné) :
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME / DB_USER / DB_PASS : alignés sur le serveur (données sensibles, non commitées)
# Dump EC2 → data/mysql-dumps/ : ./dump-db-from-server.sh puis DB_HOST=localhost + import mysql (voir script).
# Impératif : copier depuis le .env serveur BACKEND_KEK_HEX (+ LEGACY_ENCRYPTION_KEY si utilisé), sinon déchiffrement KO (noms patient « · », form_data vide).
# Tunnel lent : préférer dump + MySQL local ; SSH_TUNNEL_COMPRESS dans rundev.sh (0 pour désactiver -C).

# -----------------------------------------------------------------------------
# Sécurité / Chiffrement HDS
# -----------------------------------------------------------------------------
# Clé de chiffrement (32 bytes en hex). Générer : openssl rand -hex 32

ENCRYPTION_KEY=592a7c5e577f31129950da0a582696a416ab66c13f43a5a2ad1f19a6ec5cb8cb
BACKEND_KEK_HEX=592a7c5e577f31129950da0a582696a416ab66c13f43a5a2ad1f19a6ec5cb8cb
JWT_SECRET=455e595eb5a7e2fbba28788469b0106b651527da10deb70a432518ce1d2f4d3a


# -----------------------------------------------------------------------------
# CORS (origines autorisées pour l'API, séparées par des virgules)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://cary.bio,https://www.cary.bio,http://cary.bio,http://www.cary.bio

# -----------------------------------------------------------------------------
# URLs applicatives (pour emails, redirections, etc.)
# -----------------------------------------------------------------------------
FRONTEND_URL=https://cary.bio
API_URL=https://cary.bio

# -----------------------------------------------------------------------------
# SMTP (envoi d'emails) — IONOS (ex. contact@cary.bio)
# -----------------------------------------------------------------------------
# SMTP Brevo (envoi d'emails transactionnels — OTP, notifications)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_EMAIL=contact@cary.bio
SMTP_FROM_NAME=Cary
EMAIL_FROM=contact@cary.bio

# Alertes email équipe (inscriptions, RDV, paiements Stripe). Séparateur : virgule.
# Par défaut : emails des comptes super_admin, sinon SMTP_FROM_EMAIL.
ADMIN_NOTIFY_EMAIL=contact@cary.bio

# Logo dans les emails (optionnel, sinon FRONTEND_URL + /images/logo-cary.png)
# EMAIL_LOGO_URL=https://cary.bio/images/logo-cary.png
# Largeur max du logo en px (80–280, défaut 168 — logo horizontal Cary)
# EMAIL_LOGO_MAX_WIDTH=168
# Couleur primaire des boutons / accent (hex, défaut bleu app #2563eb)
# EMAIL_BRAND_PRIMARY=#2563eb

# -----------------------------------------------------------------------------
# Google Maps Platform (Geocoding – recherche d’adresses, côté serveur uniquement)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Brevo SMS (prioritaire — remplace Twilio pour les notifications Cary)
# IMPORTANT : clé SMTP e-mail (xsmtpsib-…) ≠ clé API REST (xkeysib-…).
# Brevo → SMTP & API → onglet « API keys » → générer → BREVO_API_KEY ci-dessous.
BREVO_SMS_API_KEY=
BREVO_API_KEY=
BREVO_SMS_SENDER=CARYBIO
BREVO_SMS_BRAND=CARYBIO

# -----------------------------------------------------------------------------
# Twilio (SMS – repli uniquement si Brevo non configuré)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Nom affiché comme expéditeur SMS Twilio (alphanumérique, max 11 car. — sans point)
TWILIO_SENDER_ID=CaryBio
# Libellé dans le corps du SMS (ex. « Cary.bio: Bonjour… »)
TWILIO_SMS_BRAND=Cary.bio

# -----------------------------------------------------------------------------
# Stripe (Live Cary — prod cary.bio). Ne pas commiter sk_/whsec_ réels ici : copier depuis .env local.
# Price IDs Cary (compte acct_1SckD8Gh8t9qKbqT) :
#   Infirmier Pro 29 €/mois  → price_1TjL1RGh8t9qKbqT1bqudmA4
#   Lab Starter 49 €/mois    → price_1TjL1XGh8t9qKbqTvp0URv02
#   Lab Pro 129 €/mois       → price_1TjL1XGh8t9qKbqTLuwOd1Ec
#   Horaire VIP 14,99 €      → price_1TjL1YGh8t9qKbqTCfzmxxNA
# Webhook : https://cary.bio/api/stripe/webhook
# -----------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_NURSE_PRO=price_1TjL1RGh8t9qKbqT1bqudmA4
STRIPE_PRICE_LAB_STARTER=price_1TjL1XGh8t9qKbqTvp0URv02
STRIPE_PRICE_LAB_PRO=price_1TjL1XGh8t9qKbqTLuwOd1Ec
STRIPE_PRICE_PATIENT_URGENCY=price_1TjL1YGh8t9qKbqTCfzmxxNA

# IAP mobile (Apple / Google Play — Cary Pro infirmier)
IAP_NURSE_PRO_PRODUCT_ID=cary.pro.monthly
IAP_PATIENT_VIP_PRODUCT_ID=cary.patient.blood.vip
# Dev uniquement — jamais en production
IAP_ALLOW_UNVERIFIED=false
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
# APPLE_IAP_PRIVATE_KEY= (contenu PEM inline, alternative au path)
APPLE_IAP_BUNDLE_ID=com.carybioapp.app
APPLE_IAP_ENVIRONMENT=production
GOOGLE_IAP_PACKAGE_NAME=com.carybioapp.app
GOOGLE_IAP_SERVICE_ACCOUNT_PATH=

# Mise à jour obligatoire app mobile (GET /api/app/version)
# Augmenter MOBILE_*_MIN_VERSION (et MOBILE_ANDROID_MIN_VERSION_CODE) pour bloquer les anciennes versions.
MOBILE_IOS_MIN_VERSION=1.0.0
MOBILE_IOS_LATEST_VERSION=1.7.9
MOBILE_IOS_APP_STORE_ID=6778805884
# MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id6778805884
MOBILE_ANDROID_MIN_VERSION=1.0.0
MOBILE_ANDROID_LATEST_VERSION=1.7.9
MOBILE_ANDROID_MIN_VERSION_CODE=7
# MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.carybioapp.app
# MOBILE_UPDATE_FORCE_MESSAGE=Une nouvelle version de Cary est disponible…
# MOBILE_UPDATE_OPTIONAL_MESSAGE=Une mise à jour de Cary est disponible…

# -----------------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=https://cary.bio/api
NUXT_PUBLIC_SITE_URL=https://cary.bio

# -----------------------------------------------------------------------------
# Cron – clôture auto RDV (backend/cron/auto-complete-appointments.php)
# Vide = premier super_admin en base ; sinon UUID du profil super_admin.
# -----------------------------------------------------------------------------
CRON_AUTO_COMPLETE_ACTOR_ID=

# -----------------------------------------------------------------------------
# Cron – rediffusion zone après partage lien infirmier (backend/cron/redispatch-nurse-share-pending.php)
# Minutes avant relance dispatchGeographic (entier ≥ 1 ; invalide/absent = 30).
# -----------------------------------------------------------------------------
NURSE_SHARE_REDISPATCH_MINUTES=30

# -----------------------------------------------------------------------------
# Environnement (development | production)
# -----------------------------------------------------------------------------
APP_ENV=production
# OTP en clair dans POST /auth/request-otp — réservé dev/QA local uniquement.
EXPOSE_OTP_IN_API=false

# -----------------------------------------------------------------------------
# IA Cary (Grok xAI v1 — ne pas commiter la clé réelle)
# -----------------------------------------------------------------------------
XAI_API_KEY=
ACTIVE_AI_PROVIDER=grok
XAI_MODEL=grok-3
# Voix Cary mode vocal : ara | eve | leo | rex | sal (Grok TTS xAI)
XAI_TTS_VOICE_ID=ara

# Qdrant RAG (Phase B — localhost EC2, port non exposé publiquement)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cary_patient_rag
XAI_API_KEY=
XAI_EMBEDDING_MODEL=text-embedding-3-large
# Embeddings RAG — xAI (Grok) utilise la même clé que le chat ; OpenAI optionnel
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_SIZE=1536
