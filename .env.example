# =============================================================================
# OneAndLab – Variables d'environnement (Backend + déploiement)
# =============================================================================
# Copier vers .env et remplir les valeurs (ne pas commiter .env).
# Sur le serveur ECS : placer ce fichier à /var/www/oneandlab/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données MySQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oneandlab
DB_USER=oneandlab
DB_PASS=

# -----------------------------------------------------------------------------
# Sécurité / Chiffrement HDS
# -----------------------------------------------------------------------------
# Clé de chiffrement (32 bytes en hex). Générer : openssl rand -hex 32

ENCRYPTION_KEY=592a7c5e577f31129950da0a582696a416ab66c13f43a5a2ad1f19a6ec5cb8cb
BACKEND_KEK_HEX=592a7c5e577f31129950da0a582696a416ab66c13f43a5a2ad1f19a6ec5cb8cb
JWT_SECRET=455e595eb5a7e2fbba28788469b0106b651527da10deb70a432518ce1d2f4d3a


# -----------------------------------------------------------------------------
# CORS (origines autorisées pour l'API, séparées par des virgules)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.oneandlab.fr,http://app.oneandlab.fr

# -----------------------------------------------------------------------------
# URLs applicatives (pour emails, redirections, etc.)
# -----------------------------------------------------------------------------
FRONTEND_URL=https://app.oneandlab.fr
API_URL=https://app.oneandlab.fr

# -----------------------------------------------------------------------------
# SMTP (envoi d'emails)
# -----------------------------------------------------------------------------
SMTP_HOST=pro3.mail.ovh.net
SMTP_PORT=587
SMTP_USER=contact@oneandlab.fr
SMTP_PASS=Rambirkapourt7.
SMTP_SECURE=false
SMTP_FROM_EMAIL=contact@oneandlab.fr
SMTP_FROM_NAME=OneAndLab
EMAIL_FROM=noreply@oneandlab.fr

# Logo dans les emails (optionnel, sinon FRONTEND_URL + /images/onelogo.png)
# EMAIL_LOGO_URL=https://app.oneandlab.fr/logo-email.png
# Largeur max du logo en px (80–280, défaut 140 — évite l’étirement entre clients mail)
# EMAIL_LOGO_MAX_WIDTH=140
# Couleur primaire des boutons / accent (hex, défaut bleu app #2563eb)
# EMAIL_BRAND_PRIMARY=#2563eb

# -----------------------------------------------------------------------------
# Google Maps Platform (Geocoding – recherche d’adresses, côté serveur uniquement)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Twilio (SMS – optionnel)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Stripe (abonnements infirmiers / laboratoires – optionnel)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_NURSE_PRO=
STRIPE_PRICE_LAB_STARTER=
STRIPE_PRICE_LAB_PRO=

# -----------------------------------------------------------------------------
# Frontend (Nuxt) – utilisées au build (npm run build) sur le serveur
# -----------------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=https://app.oneandlab.fr/api
NUXT_PUBLIC_SITE_URL=https://app.oneandlab.fr

# -----------------------------------------------------------------------------
# Cron – clôture auto RDV (backend/cron/auto-complete-appointments.php)
# Vide = premier super_admin en base ; sinon UUID du profil super_admin.
# -----------------------------------------------------------------------------
CRON_AUTO_COMPLETE_ACTOR_ID=

# -----------------------------------------------------------------------------
# Cron – rediffusion zone après partage lien infirmier (backend/cron/redispatch-nurse-share-pending.php)
# Minutes avant relance dispatchGeographic (entier ≥ 1 ; invalide/absent = 30).
# -----------------------------------------------------------------------------
NURSE_SHARE_REDISPATCH_MINUTES=30

# -----------------------------------------------------------------------------
# Environnement (development | production)
# -----------------------------------------------------------------------------
APP_ENV=production
