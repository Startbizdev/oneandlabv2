# Archive EAS (monorepo Cary) — source : racine git, app dans apps/mobile/
# IMPORTANT : lancer via npm run build:ios:store (scripts/run-eas-ios.cjs) qui définit EAS_NO_VCS=1.
# Sans EAS_NO_VCS, .git (~2 Go) peut être inclus → échec upload metadata.

# --- Git (critique Windows / monorepo) ---
.git
.git/
**/.git
**/.git/

# --- Monorepo : hors build mobile ---
backend/
backend/uploads/
frontend/
apps/web/
/database/
/docs/
/scripts/
/vendor/
/uploads/
/data/
/backups/

# --- Cursor / plans locaux ---
.cursor/
**/.cursor/

# --- Dépendances (réinstallées sur EAS via eas-build-pre-install) ---
node_modules/
**/node_modules/

# --- Natif généré par EAS Prebuild (ne pas uploader le dossier local) ---
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.kotlin/
apps/mobile/.expo/

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# --- Build / cache / logs ---
dist/
.output/
.nuxt/
.nitro/
web-build/
coverage/
**/*.log
/logs/
**/*.tsbuildinfo
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# --- PHP / Composer (inutile pour mobile) ---
composer
composer.phar
composer-setup.php

# --- OS / divers ---
.DS_Store
Thumbs.db
*.swp
*.swo
*.sqlite
*.db
*.tar.gz
*.zip
