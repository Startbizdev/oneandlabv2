{
  "expo": {
    "name": "Cary",
    "slug": "cary-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cary",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F4FAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cary.mobile",
      "infoPlist": {
        "CFBundleDisplayName": "Cary",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Cary a besoin d’accéder à vos photos pour joindre des documents médicaux à vos rendez-vous.",
        "NSCameraUsageDescription": "Cary peut utiliser l’appareil photo pour joindre des documents à vos rendez-vous.",
        "NSFaceIDUsageDescription": "Cary utilise Face ID pour vous connecter sans saisir de code à chaque ouverture.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4FAFA"
      },
      "package": "com.cary.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/splash-logo.png",
            "imageWidth": 250,
            "resizeMode": "contain",
            "backgroundColor": "#F4FAFA"
          },
          "android": {
            "image": "./assets/splash-logo.png",
            "imageWidth": 250,
            "resizeMode": "contain",
            "backgroundColor": "#F4FAFA"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Cary utilise Face ID pour sécuriser vos identifiants de connexion."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cary utilise Face ID pour vous connecter rapidement et en toute sécurité."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1CC7B5"
        }
      ],
      "expo-image-picker",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
