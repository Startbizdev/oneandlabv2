{
  "name": "@oneandlab/mobile",
  "version": "1.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "eas-build-pre-install": "cd ../.. && npm ci --workspace=@oneandlab/mobile --include-workspace-root",
    "eas-build-post-install": "node scripts/eas-chmod-pod-scripts.cjs",
    "bundle:ios:verify": "expo export --platform ios",
    "verify:eas": "node scripts/verify-eas-archive-size.cjs && node scripts/verify-eas-preflight.cjs",
    "postinstall": "node scripts/patch-expo-ngrok.cjs",
    "start": "node scripts/start-expo-dev.cjs",
    "start:localhost": "expo start",
    "start:tunnel": "node scripts/start-expo-dev.cjs --tunnel",
    "start:clean": "node scripts/clean-metro.cjs && node scripts/start-expo-dev.cjs -c",
    "clean:metro": "node scripts/clean-metro.cjs",
    "clean:all": "bash scripts/clean-all.sh",
    "prebuild:ios:clean": "expo prebuild --platform ios --clean",
    "prebuild:android:clean": "expo prebuild --platform android --clean",
    "android": "expo run:android",
    "ios": "bash scripts/open-ios.sh",
    "ios:setup": "bash scripts/setup-ios-native.sh",
    "ios:dev-build": "expo run:ios",
    "icons:generate": "bash scripts/generate-brand-icons.sh",
    "build:ios:store": "node scripts/run-eas-ios.cjs",
    "submit:ios:latest": "node scripts/run-eas-ios.cjs submit --platform ios --profile production --latest --non-interactive",
    "typecheck": "tsc --noEmit",
    "simulate:iap": "node scripts/simulate-iap-purchase.cjs",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:styles": "node scripts/lint-themed-styles.mjs",
    "lint:styles:strict": "node scripts/lint-themed-styles.mjs --strict-colors",
    "lint:layout": "node scripts/lint-layout.mjs --ratchet",
    "verify": "npm run typecheck && npm run lint:layout && npm run lint:styles:strict && npm run lint -- --max-warnings 9999"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^3.9.1",
    "@oneandlab/shared-api": "*",
    "@oneandlab/shared-constants": "*",
    "@oneandlab/shared-types": "*",
    "@oneandlab/shared-utils": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/elements": "^2.6.4",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.100.14",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-query-persist-client": "^5.100.14",
    "axios": "^1.7.9",
    "babel-preset-expo": "~54.0.10",
    "dayjs": "^1.11.13",
    "expo": "~54.0.35",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.8",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.7",
    "expo-iap": "^4.3.1",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.11",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-web-browser": "~15.0.7",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
