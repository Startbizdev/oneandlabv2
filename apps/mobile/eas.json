{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "prebuildCommand": "npx expo prebuild --clean --platform ios",
      "cache": {
        "disabled": true
      },
      "env": {
        "EAS_BUILD_DISABLE_COCOAPODS_CACHE": "1",
        "EAS_RESTORE_CACHE": "0"
      },
      "ios": {
        "autoIncrement": true,
        "image": "macos-sequoia-15.6-xcode-16.4",
        "cocoapods": "1.16.2"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "joopixstudio@gmail.com"
      }
    }
  }
}
