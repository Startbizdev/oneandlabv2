{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "prebuildCommand": "node scripts/eas-prebuild-ios.cjs",
      "env": {
        "RCT_BUILD_HERMES_FROM_SOURCE": "true",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "RCT_USE_RN_DEP": "0",
        "EAS_BUILD_DISABLE_COCOAPODS_CACHE": "1"
      },
      "ios": {
        "autoIncrement": true,
        "cocoapods": "1.16.2"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "joopixstudio@gmail.com"
      }
    }
  }
}
